rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function accountBinding() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid));
    }
    function ownsHumanRoot(humanUserId) {
      let root = get(/databases/$(database)/documents/users/$(humanUserId));
      return isAuthenticated()
        && accountBinding().data.status == "ACTIVE"
        && accountBinding().data.schemaVersion == 1
        && accountBinding().data.humanUserId == humanUserId
        && root.data.status == "ACTIVE"
        && root.data.schemaVersion == 1
        && root.data.ownerFirebaseUid == request.auth.uid;
    }
    function hasActiveStudioEntitlement(humanUserId) {
      let current = get(/databases/$(database)/documents/accounts/$(request.auth.uid)/entitlements/current);
      return ownsHumanRoot(humanUserId)
        && current.data.schemaVersion == 1
        && current.data.firebaseUid == request.auth.uid
        && current.data.humanUserId == humanUserId
        && ((current.data.normalizedState == "ACTIVE_UNTIL_EXPIRY"
              && current.data.productScope == "WORKOUT_STUDIO"
              && current.data.expiryAt is timestamp
              && current.data.expiryAt > request.time)
          || (current.data.products.WORKOUT_STUDIO.normalizedState == "ACTIVE_UNTIL_EXPIRY"
              && current.data.products.WORKOUT_STUDIO.expiryAt is timestamp
              && current.data.products.WORKOUT_STUDIO.expiryAt > request.time));
    }
    function createsOwnedPlannerRecord(humanUserId) {
      return request.resource.data.humanUserId == humanUserId;
    }
    function updatesOwnedPlannerRecord(humanUserId) {
      return resource.data.humanUserId == humanUserId
        && request.resource.data.humanUserId == humanUserId;
    }
    function createsOwnedMeasurementRecord(humanUserId, documentId) {
      return request.resource.data.humanUserId == humanUserId
        && request.resource.data.schemaVersion == 14
        && request.resource.data.globalId == documentId
        && request.resource.data.loggedSetGlobalId is string
        && request.resource.data.metricKey is string
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
    }
    function updatesOwnedMeasurementRecord(humanUserId, documentId) {
      return resource.data.humanUserId == humanUserId
        && resource.data.globalId == request.resource.data.globalId
        && resource.data.loggedSetGlobalId == request.resource.data.loggedSetGlobalId
        && createsOwnedMeasurementRecord(humanUserId, documentId)
        && request.resource.data.revision >= resource.data.revision;
    }
    function validStudioDraft(humanUserId, documentId) {
      return request.resource.data.keys().hasAll([
          "schemaVersion", "globalId", "humanUserId", "revision", "status",
          "payload", "createdAt", "updatedAt", "deletedAt", "originClientId"
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.globalId == documentId
        && request.resource.data.humanUserId == humanUserId
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.status == "DRAFT"
        && request.resource.data.payload is map
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (request.resource.data.deletedAt == null || request.resource.data.deletedAt is string)
        && request.resource.data.originClientId is string;
    }
    function createsStudioDraft(humanUserId, documentId) {
      return ownsHumanRoot(humanUserId) && validStudioDraft(humanUserId, documentId);
    }
    function updatesStudioDraft(humanUserId, documentId) {
      return ownsHumanRoot(humanUserId)
        && validStudioDraft(humanUserId, documentId)
        && resource.data.humanUserId == humanUserId
        && request.resource.data.humanUserId == resource.data.humanUserId
        && request.resource.data.globalId == resource.data.globalId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision > resource.data.revision;
    }
    function validPublicationState(data) {
      return (data.publicationState == "PUBLISHED" && data.tombstoneState == "ACTIVE")
        || (data.publicationState == "TOMBSTONED" && data.tombstoneState == "SOFT_DELETED");
    }
    function validPublishedVersion(humanUserId, versionId, contentType) {
      return request.resource.data.keys().hasAll([
          "schemaVersion", "globalId", "humanUserId", "revision",
          "publicationState", "tombstoneState", "sourceDraftId", "payload",
          "createdAt", "updatedAt", "publishedAt", "contentChecksum",
          "versionId", "contentType", "compatibleTags"
        ])
        && request.resource.data.schemaVersion is string
        && request.resource.data.schemaVersion != ""
        && request.resource.data.globalId is string
        && request.resource.data.globalId != ""
        && request.resource.data.humanUserId == humanUserId
        && request.resource.data.sourceDraftId == request.resource.data.globalId
        && request.resource.data.versionId == versionId
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && validPublicationState(request.resource.data)
        && request.resource.data.payload is map
        && request.resource.data.contentChecksum is string
        && request.resource.data.contentChecksum.matches("^[0-9a-f]{64}$")
        && request.resource.data.compatibleTags is list
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.publishedAt is string
        && request.resource.data.contentType == contentType;
    }
    function validPublishedPlan(humanUserId, versionId) {
      return validPublishedVersion(humanUserId, versionId, "plan")
        && request.resource.data.payload.weeks is list;
    }
    function createsOwnedVersionedRecord(humanUserId, documentId) {
      return ownsHumanRoot(humanUserId)
        && request.resource.data.humanUserId == humanUserId
        && request.resource.data.globalId == documentId
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && (request.resource.data.deletedAt == null || request.resource.data.deletedAt is int)
        && request.resource.data.originDeviceId is string;
    }
    function updatesOwnedVersionedRecord(humanUserId, documentId) {
      return createsOwnedVersionedRecord(humanUserId, documentId)
        && resource.data.humanUserId == humanUserId
        && resource.data.globalId == documentId
        && request.resource.data.humanUserId == resource.data.humanUserId
        && request.resource.data.globalId == resource.data.globalId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision > resource.data.revision;
    }
    function validPrivateExercise(humanUserId, documentId) {
      return createsOwnedVersionedRecord(humanUserId, documentId)
        && documentId.matches('^(private|custom)_[A-Za-z0-9_-]{8,}$')
        && request.resource.data.id == documentId
        && request.resource.data.isCustom == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category is string;
    }
    function validTemplate(humanUserId, documentId) {
      return createsOwnedVersionedRecord(humanUserId, documentId)
        && request.resource.data.name is string
        && request.resource.data.exerciseIdsJson is string;
    }
    function validTemplateExercise(humanUserId, documentId) {
      return createsOwnedVersionedRecord(humanUserId, documentId)
        && request.resource.data.templateGlobalId is string
        && request.resource.data.exerciseId is string
        && request.resource.data.position is int;
    }
    function validTemplateSet(humanUserId, documentId) {
      return createsOwnedVersionedRecord(humanUserId, documentId)
        && request.resource.data.templateExerciseGlobalId is string
        && request.resource.data.position is int
        && request.resource.data.setType is string;
    }
    function validWorkoutDeliveryAck(humanUserId, acknowledgementId) {
      let publication = get(/databases/$(database)/documents/users/$(humanUserId)/publishedWorkouts/$(request.resource.data.versionId));
      return request.resource.data.keys().hasOnly([
          "schemaVersion", "acknowledgementId", "humanUserId", "workoutGlobalId",
          "versionId", "applicationId", "appliedChecksum", "sourceRevision",
          "state", "reasonCode", "clientAppliedAtMillis", "createdAt"
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.acknowledgementId == acknowledgementId
        && request.resource.data.humanUserId == humanUserId
        && request.resource.data.workoutGlobalId is string
        && request.resource.data.workoutGlobalId != ""
        && request.resource.data.versionId is string
        && request.resource.data.versionId != ""
        && request.resource.data.applicationId == "HUMAN_STRENGTH"
        && request.resource.data.appliedChecksum is string
        && request.resource.data.appliedChecksum.matches("^[0-9a-f]{64}$")
        && request.resource.data.sourceRevision is int
        && request.resource.data.sourceRevision >= 1
        && request.resource.data.state in ["APPLIED", "CONFLICT", "REJECTED"]
        && (request.resource.data.reasonCode == null || request.resource.data.reasonCode is string)
        && request.resource.data.clientAppliedAtMillis is int
        && request.resource.data.createdAt == request.time
        && publication.data.humanUserId == humanUserId
        && publication.data.globalId == request.resource.data.workoutGlobalId
        && publication.data.revision == request.resource.data.sourceRevision
        && publication.data.contentChecksum == request.resource.data.appliedChecksum;
    }

    match /accounts/{uid} {
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
      match /entitlements/current { allow get: if isAuthenticated() && request.auth.uid == uid; allow list, write: if false; }
      match /entitlements/{document=**} { allow read, write: if false; }
      match /entitlementGrants/{document=**} { allow read, write: if false; }
      match /entitlementEvents/{document=**} { allow read, write: if false; }
    }

    match /users/{humanUserId} {
      // HIIT uses this single-document read as its trusted-identity sync gate.
      // Listing Human roots and all client root mutations remain forbidden.
      allow get: if ownsHumanRoot(humanUserId);
      allow list, create, update, delete: if false;
      match /profile/{document} { allow read, write: if ownsHumanRoot(humanUserId); }
      match /weight/{document} { allow read, write: if ownsHumanRoot(humanUserId); }
      match /tape/{document} { allow read, write: if ownsHumanRoot(humanUserId); }
      match /customExercises/{document} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if validPrivateExercise(humanUserId, document);
        allow update: if validPrivateExercise(humanUserId, document) && updatesOwnedVersionedRecord(humanUserId, document);
        allow delete: if false;
      }
      match /templates/{document} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if validTemplate(humanUserId, document);
        allow update: if validTemplate(humanUserId, document) && updatesOwnedVersionedRecord(humanUserId, document);
        allow delete: if false;
      }
      match /templateExercises/{document} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if validTemplateExercise(humanUserId, document);
        allow update: if validTemplateExercise(humanUserId, document) && updatesOwnedVersionedRecord(humanUserId, document);
        allow delete: if false;
      }
      match /templateSets/{document} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if validTemplateSet(humanUserId, document);
        allow update: if validTemplateSet(humanUserId, document) && updatesOwnedVersionedRecord(humanUserId, document);
        allow delete: if false;
      }
      match /sessions/{document} { allow read, write: if ownsHumanRoot(humanUserId); }
      match /loggedSets/{document} { allow read, write: if ownsHumanRoot(humanUserId); }
      // V37 records are additive. Older clients ignore this collection and
      // continue syncing legacy loggedSets without losing completion state.
      match /measurementRecords/{document} {
        allow read: if ownsHumanRoot(humanUserId);
        allow delete: if false;
        allow create: if ownsHumanRoot(humanUserId) && createsOwnedMeasurementRecord(humanUserId, document);
        allow update: if ownsHumanRoot(humanUserId) && updatesOwnedMeasurementRecord(humanUserId, document);
      }
      // Workout Studio drafts remain owner-scoped, revision-monotonic and
      // soft-delete only. They do not confer platform authority.
      match /workoutDrafts/{document} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if hasActiveStudioEntitlement(humanUserId) && createsStudioDraft(humanUserId, document);
        allow update: if hasActiveStudioEntitlement(humanUserId) && updatesStudioDraft(humanUserId, document);
        allow delete: if false;
      }
      match /planDrafts/{document} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if hasActiveStudioEntitlement(humanUserId) && createsStudioDraft(humanUserId, document);
        allow update: if hasActiveStudioEntitlement(humanUserId) && updatesStudioDraft(humanUserId, document);
        allow delete: if false;
      }
      match /protocolDrafts/{document} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if hasActiveStudioEntitlement(humanUserId) && createsStudioDraft(humanUserId, document);
        allow update: if hasActiveStudioEntitlement(humanUserId) && updatesStudioDraft(humanUserId, document);
        allow delete: if false;
      }
      // Published versions are append-only immutable records. Plans carry
      // exact workoutVersionId references inside their typed weeks payload;
      // application validation proves every placement has that version key.
      match /publishedWorkouts/{versionId} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if hasActiveStudioEntitlement(humanUserId)
          && validPublishedVersion(humanUserId, versionId, "workout");
        allow update, delete: if false;
      }
      match /publishedPlans/{versionId} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if hasActiveStudioEntitlement(humanUserId)
          && validPublishedPlan(humanUserId, versionId);
        allow update, delete: if false;
      }
      match /publishedProtocols/{versionId} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if hasActiveStudioEntitlement(humanUserId)
          && validPublishedVersion(humanUserId, versionId, "protocol");
        allow update, delete: if false;
      }
      match /workoutDeliveryAcks/{acknowledgementId} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if ownsHumanRoot(humanUserId)
          && validWorkoutDeliveryAck(humanUserId, acknowledgementId);
        allow update, delete: if false;
      }
      match /processedCommands/{document} { allow read, write: if ownsHumanRoot(humanUserId); }
      match /trainingPlans/{document} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if createsOwnedPlannerRecord(humanUserId) && createsOwnedVersionedRecord(humanUserId, document);
        allow update: if updatesOwnedPlannerRecord(humanUserId) && updatesOwnedVersionedRecord(humanUserId, document);
        allow delete: if false;
      }
      match /plannedWorkouts/{document} {
        allow read: if ownsHumanRoot(humanUserId);
        allow create: if createsOwnedPlannerRecord(humanUserId) && createsOwnedVersionedRecord(humanUserId, document);
        allow update: if updatesOwnedPlannerRecord(humanUserId) && updatesOwnedVersionedRecord(humanUserId, document);
        allow delete: if false;
      }
    }

    // The governed catalogue is global, non-user data. Published production
    // releases are publicly readable so bundled-first refresh also works before
    // sign-in; all client writes and all unpublished content remain denied.
    match /exercise_catalogue/{documentId} {
      allow read: if resource.data.status == "published"
        && resource.data.channel == "production";
      allow create, update, delete: if false;
    }
    match /exercise_catalogue_releases/{releaseId} {
      allow read: if resource.data.status == "published"
        && resource.data.channel == "production";
      allow create, update, delete: if false;
      match /exercises/{exerciseId} {
        allow read: if get(/databases/$(database)/documents/exercise_catalogue_releases/$(releaseId)).data.status == "published"
          && get(/databases/$(database)/documents/exercise_catalogue_releases/$(releaseId)).data.channel == "production";
        allow create, update, delete: if false;
      }
    }
    match /staging_exercises/{document=**} { allow read, write: if false; }

    match /legacyIdentityEvidence/{document=**} { allow read, write: if false; }
    match /entitlements/{document=**} { allow read, write: if false; }
    match /trialPolicies/{document=**} { allow read, write: if false; }
    match /platform_config/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
