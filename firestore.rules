rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function accountPath() { return /databases/$(database)/documents/accounts/$(request.auth.uid); }
    function humanPath(humanUserId) { return /databases/$(database)/documents/users/$(humanUserId); }
    function owns(humanUserId) {
      return signedIn() && exists(accountPath())
        && get(accountPath()).data.humanUserId == humanUserId
        && get(accountPath()).data.status == 'ACTIVE' && get(accountPath()).data.schemaVersion == 1
        && exists(humanPath(humanUserId))
        && get(humanPath(humanUserId)).data.ownerFirebaseUid == request.auth.uid
        && get(humanPath(humanUserId)).data.status == 'ACTIVE' && get(humanPath(humanUserId)).data.schemaVersion == 1;
    }
    function releaseIsReadable(releaseId) {
      let release = get(/databases/$(database)/documents/exercise_catalogue_releases/$(releaseId));
      return release.data.status == 'published' && release.data.channel == 'production' && release.data.validationStatus == 'validated';
    }

    match /accounts/{firebaseUid} {
      allow read: if signedIn() && request.auth.uid == firebaseUid;
      allow write: if false;
      match /entitlements/{documentId} {
        allow read: if signedIn() && request.auth.uid == firebaseUid && documentId == 'current';
        allow write: if false;
      }
    }
    match /exercise_catalogue/current { allow read: if signedIn(); allow write: if false; }
    match /exercise_catalogue_releases/{releaseId} {
      allow read: if signedIn() && resource.data.status == 'published' && resource.data.channel == 'production' && resource.data.validationStatus == 'validated';
      allow write: if false;
      match /exercises/{exerciseId} { allow read: if signedIn() && releaseIsReadable(releaseId); allow write: if false; }
    }
    match /staging_exercises/{document=**} { allow read, write: if false; }

    match /users/{humanUserId} {
      allow read: if owns(humanUserId);
      allow write: if false;
      function validDraft(data, itemId) {
        return data.keys().hasAll(['schemaVersion', 'globalId', 'humanUserId', 'revision', 'status', 'payload', 'createdAt', 'updatedAt', 'deletedAt', 'originClientId'])
          && data.schemaVersion == 1 && data.globalId == itemId && data.humanUserId == humanUserId
          && data.revision is int && data.revision >= 1 && data.status == 'DRAFT' && data.payload is map
          && data.createdAt is string && data.updatedAt is string
          && (data.deletedAt == null || data.deletedAt is string) && data.originClientId is string;
      }
      function validCreate(itemId) { return owns(humanUserId) && validDraft(request.resource.data, itemId); }
      function validUpdate(itemId) {
        return owns(humanUserId) && validDraft(request.resource.data, itemId)
          && request.resource.data.humanUserId == resource.data.humanUserId
          && request.resource.data.globalId == resource.data.globalId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revision > resource.data.revision;
      }
      match /workoutDrafts/{itemId} {
        allow read: if owns(humanUserId); allow create: if validCreate(itemId); allow update: if validUpdate(itemId); allow delete: if false;
      }
      match /planDrafts/{itemId} {
        allow read: if owns(humanUserId); allow create: if validCreate(itemId); allow update: if validUpdate(itemId); allow delete: if false;
      }
      match /protocolDrafts/{itemId} {
        allow read: if owns(humanUserId); allow create: if validCreate(itemId); allow update: if validUpdate(itemId); allow delete: if false;
      }
      function validPublished(data, itemId, contentType) {
        return data.keys().hasAll(['schemaVersion', 'globalId', 'humanUserId', 'revision', 'publicationState', 'payload', 'createdAt', 'updatedAt', 'publishedAt', 'contentChecksum', 'versionId', 'contentType'])
          && data.schemaVersion == 1 && data.humanUserId == humanUserId
          && data.versionId == itemId && data.revision is int && data.revision >= 1
          && data.publicationState in ['PUBLISHED', 'TOMBSTONED']
          && data.payload is map && data.contentChecksum is string && data.contentChecksum != ''
          && data.createdAt is string && data.updatedAt is string && data.publishedAt is string
          && data.contentType == contentType;
      }
      match /publishedWorkouts/{itemId} {
        allow read: if owns(humanUserId);
        allow create: if owns(humanUserId) && validPublished(request.resource.data, itemId, 'workout');
        allow update, delete: if false;
      }
      match /publishedPlans/{itemId} {
        allow read: if owns(humanUserId);
        allow create: if owns(humanUserId) && validPublished(request.resource.data, itemId, 'plan');
        allow update, delete: if false;
      }
      match /publishedProtocols/{itemId} {
        allow read: if owns(humanUserId);
        allow create: if owns(humanUserId) && validPublished(request.resource.data, itemId, 'protocol');
        allow update, delete: if false;
      }
      match /{immutableCollection}/{itemId} {
        allow read: if owns(humanUserId) && immutableCollection in ['workouts', 'workoutVersions', 'plans', 'planVersions', 'protocols', 'protocolVersions', 'studioCommands', 'studioProcessedCommands'];
        allow write: if false;
      }
    }
  }
}
